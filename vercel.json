{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install -g pnpm@12.9.1 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:hosted",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(index|pwa).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/judge/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self' blob:; form-action 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self' blob:; form-action 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/judge",
      "destination": "/judge/index.html"
    },
    {
      "source": "/judge/",
      "destination": "/judge/index.html"
    },
    {
      "source": "/judge/demo",
      "destination": "/judge/demo/index.html"
    },
    {
      "source": "/judge/demo/",
      "destination": "/judge/demo/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "destination": "https://civic-flow.vercel.app/",
      "permanent": false
    },
    {
      "source": "/judge",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "destination": "https://civic-flow.vercel.app/",
      "permanent": false
    },
    {
      "source": "/judge/",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "destination": "https://civic-flow.vercel.app/",
      "permanent": false
    },
    {
      "source": "/judge/demo",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "destination": "https://civic-flow.vercel.app/",
      "permanent": false
    },
    {
      "source": "/judge/demo/",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "destination": "https://civic-flow.vercel.app/",
      "permanent": false
    },
    {
      "source": "/judge/demo/index.html",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "destination": "https://civic-flow.vercel.app/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "civic-flow-sample-praket7.vercel.app"
        }
      ],
      "destination": "https://civic-flow.vercel.app/",
      "permanent": false
    }
  ]
}
